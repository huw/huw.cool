{
  "name": "huw-cool",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm css && observable build",
    "check:lint": "biome check .",
    "clean": "rm -rf src/.observablehq/cache dist",
    "css": "postcss src/style.css -o src/style.generated.css",
    "css:watch": "postcss src/style.css -o src/style.generated.css --watch",
    "deploy": "wrangler deploy",
    "dev": "concurrently --kill-others 'pnpm css:watch' 'observable preview --no-open'",
    "fix:lint": "biome check --write ."
  },
  "dependencies": {
    "@observablehq/framework": "^1.13.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "postcss-preset-env": "^11.3.2",
    "wrangler": "^4.119.0"
  },
  "engines": {
    "node": ">=18"
  }
}
