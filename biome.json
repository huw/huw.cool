{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "ignore": ["src/.observablehq", "dist", "node_modules", "src/style.generated.css", "pnpm-lock.yaml"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noProcessEnv": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  }
}
