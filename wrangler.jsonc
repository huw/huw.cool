{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huw-cool",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_als"],
  "workers_dev": false,
  "build": { "command": "pnpm build" },
  "routes": [
    { "pattern": "huw.cool", "custom_domain": true },
    { "pattern": "www.huw.cool", "custom_domain": true }
  ]
}
